# =============================================================================
# Local development
# =============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017/clinix_core
JWT_SECRET=clinix-core-dev-secret-change-me
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Production (Render / Railway / similar)
# Copy these into your host's environment-variable panel — never commit real values.
# =============================================================================

# MongoDB Atlas connection string (Database → Connect → Drivers)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/clinix_core?retryWrites=true&w=majority

# Long random string — required in production (the dev default is rejected)
# JWT_SECRET=

# NODE_ENV=production

# Monolith deploy (API serves the built frontend on the same URL):
# FRONTEND_URL=https://your-app.onrender.com

# Split deploy (frontend on Vercel/Netlify, API on Render):
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
# VITE_API_URL=https://your-api.onrender.com   ← set in the frontend host at build time

# Load the clinic demo on first boot when the database has not been seeded yet
# SEED_DEMO_DATA=true
# Replace an existing hosted demo on the next boot (wipes and reloads)
# SEED_FORCE=true
