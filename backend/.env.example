# Local defaults. Prefer the repo-root .env.example for new setups, matching CliniX Insight.
# If both files exist, this one wins. The root .env fills any key left unset.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clinix_core
JWT_SECRET=clinix-core-dev-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
