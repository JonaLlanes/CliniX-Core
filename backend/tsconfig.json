{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  // Seed runs through tsx, not the production bundle. It is excluded so a hosted build is not blocked by seed-only type errors.
  "exclude": ["src/db/seed.ts", "src/db/seed"]
}
